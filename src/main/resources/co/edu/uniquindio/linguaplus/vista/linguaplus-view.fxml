<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.linguaplus.controlador.LinguaPlusController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Academia LinguaPlus - Módulo de Registro de Matrículas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Nombre Completo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Documento:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDocumento" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Programa:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="cmbPrograma" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Modalidad:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="cmbModalidad" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Descuento (0.0 a 0.30):" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="txtDescuento" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button text="Registrar Matrícula" onAction="#onRegistrarMatricula" style="-fx-background-color: #2e7d32; -fx-text-fill: white;"/>
        <Button text="Buscar por Teléfono" onAction="#onBuscarTelefono" style="-fx-background-color: #1565c0; -fx-text-fill: white;"/>
    </HBox>

    <Label fx:id="lblMensaje" text="" style="-fx-font-weight: bold;"/>

    <TableView fx:id="tblMatriculas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" text="Matrícula #" prefWidth="100.0"/>
            <TableColumn fx:id="colEstudiante" text="Estudiante" prefWidth="250.0"/>
            <TableColumn fx:id="colPrograma" text="Programa" prefWidth="250.0"/>
            <TableColumn fx:id="colTotal" text="Total Pagado" prefWidth="150.0"/>
        </columns>
    </TableView>
</VBox>